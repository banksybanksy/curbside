# Curbside environment variables. Copy to .env; app.py reads it on start.
# Variables already set in your shell take precedence.

# Mapbox public token (starts with pk.) for the map's basemap tiles. Without
# it the pins still show, on a blank background. Create one at
# https://account.mapbox.com/access-tokens/ and restrict it to the URLs you
# serve the app from, because it is sent to the browser.
MAPBOX_TOKEN=

# Optional. DataSF's SODA API works without authentication; an app token only
# raises the rate limit for data refreshes. Register at
# https://dev.socrata.com/register.
SODA_APP_TOKEN=
